{
  "realm": "trust-guard",
  "enabled": true,
  "displayName": "Trust Guard",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername(undefined) and passwordHistory(3)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": false,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "tg-employee",
        "description": "Trust Guard: standard employee access"
      },
      {
        "name": "tg-admin",
        "description": "Trust Guard: administrator",
        "composite": true,
        "composites": {
          "realm": [
            "tg-employee"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "${TG_KC_CLIENT_ID}",
      "name": "Trust Guard (BFF)",
      "description": "Next.js backend-for-frontend, confidential OIDC client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${TG_KC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "rootUrl": "${TG_APP_URL}",
      "baseUrl": "${TG_APP_URL}",
      "redirectUris": [
        "${TG_APP_URL}/api/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${TG_APP_URL}/login?signed_out=1",
        "backchannel.logout.url": "${TG_BACKCHANNEL_LOGOUT_URL}",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "id.token.signed.response.alg": "RS256"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "authentication methods (amr)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "tg.admin",
      "enabled": true,
      "email": "admin@trustguard.local",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "realmRoles": [
        "tg-admin"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${TG_SEED_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "tg.employee",
      "enabled": true,
      "email": "employee@trustguard.local",
      "emailVerified": true,
      "firstName": "Emeka",
      "lastName": "Employee",
      "realmRoles": [
        "tg-employee"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${TG_SEED_EMPLOYEE_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "browser-conditional-credential",
      "config": {
        "credentials": "webauthn-passwordless"
      }
    },
    {
      "alias": "create unique user config",
      "config": {
        "require.password.update.after.registration": "false"
      }
    },
    {
      "alias": "first-broker-login-conditional-credential",
      "config": {
        "credentials": "webauthn-passwordless"
      }
    },
    {
      "alias": "review profile config",
      "config": {
        "update.profile.on.first.login": "missing"
      }
    },
    {
      "alias": "trust-guard amr pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "28800"
      }
    },
    {
      "alias": "trust-guard amr otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "28800"
      }
    }
  ],
