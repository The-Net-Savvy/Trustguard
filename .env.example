# =============================================================================
# Trust Guard: environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
# `.env` is read by BOTH Next.js (npm run dev) and Docker Compose.
# NEVER commit `.env`. It is git-ignored. Only this template is committed.
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME="Trust Guard"
# Public base URL of the Next.js app (used later for OIDC redirect URIs).
APP_URL=http://localhost:3000

# ---- Application database (Supabase PostgreSQL) -----------------------------
# Supabase is used ONLY as a PostgreSQL database. It is not the auth provider.
#
# Option A: Supabase cloud project
#   Dashboard > Connect > "Session pooler" (IPv4) or "Direct connection" URI:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   and set DATABASE_SSL=true
#
# Option B: Local stand-in (docker compose --profile local-db up -d)
#   postgresql://trustguard:<APP_DB_PASSWORD>@127.0.0.1:55432/trustguard
#   and set DATABASE_SSL=false
DATABASE_URL=
DATABASE_SSL=false

# Only used by the optional local stand-in database container (Option B).
APP_DB_PASSWORD=

# ---- Keycloak (identity provider) --------------------------------------------
# Container bootstrap admin (used only to log in to the Keycloak admin console).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# Password for Keycloak's own internal database (separate from the app DB).
KEYCLOAK_DB_PASSWORD=

# OIDC client settings used by the Trust Guard BFF. These are filled in during the
# authentication phase, after the realm and client are created in Keycloak.
# Leaving them empty is valid: the app reports Keycloak as "not configured".
KEYCLOAK_ISSUER=
# e.g. KEYCLOAK_ISSUER=http://localhost:8080/realms/trust-guard
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# ---- Sessions ----------------------------------------------------------------
# Secret used later to encrypt/sign the BFF session cookie (min 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
