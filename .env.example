# =============================================================================
# Trust Guard: environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
# `.env` is read by BOTH Next.js (npm run dev) and Docker Compose.
# NEVER commit `.env`. It is git-ignored. Only this template is committed.
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME="Trust Guard"
# Public base URL of the Next.js app (used later for OIDC redirect URIs).
APP_URL=http://localhost:3000

# ---- Application database (Supabase PostgreSQL) -----------------------------
# Supabase is used ONLY as a PostgreSQL database. It is not the auth provider.
#
# Option A: Supabase cloud project
#   Dashboard > Connect > "Session pooler" (IPv4) or "Direct connection" URI:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   and set DATABASE_SSL=true
#
# Option B: Local stand-in (docker compose --profile local-db up -d)
#   postgresql://trustguard:<APP_DB_PASSWORD>@127.0.0.1:55432/trustguard
#   and set DATABASE_SSL=false
DATABASE_URL=
DATABASE_SSL=false

# Only used by the optional local stand-in database container (Option B).
APP_DB_PASSWORD=

# ---- Keycloak (identity provider) --------------------------------------------
# Container bootstrap admin (used only to log in to the Keycloak admin console).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# Password for Keycloak's own internal database (separate from the app DB).
KEYCLOAK_DB_PASSWORD=

# OIDC client used by the Trust Guard BFF. The realm and client are created
# automatically from keycloak/import/trust-guard-realm.json, which reads the
# client id/secret below. Generate the secret with the command under SESSION_SECRET.
KEYCLOAK_ISSUER=http://localhost:8080/realms/trust-guard
KEYCLOAK_CLIENT_ID=trust-guard-bff
KEYCLOAK_CLIENT_SECRET=
# Where Keycloak (inside Docker) reaches the app for back-channel logout.
# KEYCLOAK_BACKCHANNEL_LOGOUT_URL=http://host.docker.internal:3000/api/auth/backchannel-logout

# Initial passwords for the two demo users created by the realm import
# (tg.admin and tg.employee). Both must enrol a TOTP authenticator at first login.
# Min 12 chars with upper case, lower case and a digit.
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# ---- Sessions ----------------------------------------------------------------
# Encrypts the stored Keycloak tokens and the login-transaction cookie (min 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Sliding idle timeout and absolute session lifetime.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# Reject logins that did not include a second factor (amr claim). Keep true.
AUTH_REQUIRE_MFA=true

# ---- Device posture & risk (phase 3) -----------------------------------------
# Re-collect the browser's device posture when the last report is older than this.
POSTURE_MAX_AGE_MINUTES=10
# Business hours for the OFF_HOURS risk signal (ISO weekdays: 1 = Monday).
BUSINESS_TIMEZONE=Africa/Lagos
BUSINESS_HOURS=07:00-19:00
BUSINESS_DAYS=1-5
# Comma-separated company network ranges for the OFF_NETWORK signal; empty disables it.
# Only meaningful behind a reverse proxy that overwrites X-Forwarded-For (see README).
TRUSTED_NETWORKS=
