{
  "name": "trust-guard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "infra:up": "docker compose up -d",
    "infra:up:local-db": "docker compose --profile local-db up -d",
    "infra:down": "docker compose --profile local-db --profile app down",
    "test:e2e:auth": "tsx scripts/e2e-auth.ts"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next": "16.3.6",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
